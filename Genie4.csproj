<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <StartupObject>GenieClient.Program</StartupObject>
    <RootNamespace>GenieClient</RootNamespace>
    <AssemblyName>Genie</AssemblyName>
    <MyType>WindowsForms</MyType>
    <ManifestCertificateThumbprint>D4B44BDE692C1D5F35229004ECA6F0B883B9056E</ManifestCertificateThumbprint>
    <ManifestKeyFile>Plugin\GenieStrongKey2020.pfx</ManifestKeyFile>
    <GenerateManifests>false</GenerateManifests>
    <TargetZone>LocalIntranet</TargetZone>
    <SignManifests>false</SignManifests>
    <IsWebBootstrapper>false</IsWebBootstrapper>
    <ApplicationIcon>Graphics\Taleweaver.ico</ApplicationIcon>
    <AssemblyOriginatorKeyFile>
    </AssemblyOriginatorKeyFile>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(ProjectDir)**\*.vb</DefaultItemExcludes>
    <LangVersion>latest</LangVersion>
    <PublishUrl>publish\</PublishUrl>
    <Install>true</Install>
    <InstallFrom>Disk</InstallFrom>
    <UpdateEnabled>false</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateInterval>7</UpdateInterval>
    <UpdateIntervalUnits>Days</UpdateIntervalUnits>
    <UpdatePeriodically>false</UpdatePeriodically>
    <UpdateRequired>false</UpdateRequired>
    <MapFileExtensions>true</MapFileExtensions>
    <UpdateUrl>http://www.clanshroud.org/dl/</UpdateUrl>
    <WebPage>publish.htm</WebPage>
    <AutorunEnabled>true</AutorunEnabled>
    <ApplicationRevision>0</ApplicationRevision>
    <UseApplicationTrust>false</UseApplicationTrust>
    <BootstrapperEnabled>true</BootstrapperEnabled>
    <!--
      Assembly metadata is generated by the SDK from the properties below plus the version in
      Directory.Build.props, so CI can inject the release version from the git tag.
      See docs/VERSIONING.md.

      Properties/AssemblyInfo.cs now holds ONLY the attributes the SDK does not generate
      (AssemblyTrademark, ComVisible, Guid). Adding a generated attribute back to that file
      causes CS0579.

      Note: Plugin/Plugins.vbproj keeps GenerateAssemblyInfo=false and its own hand-managed
      ABI version (2.0.0.1) in Plugin/AssemblyInfo.vb. Do not change that with client releases.
    -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>Genie Remix Client 4</AssemblyTitle>
    <Product>Genie Remix Client 4</Product>
    <Company>genieclient.com</Company>
    <Copyright>GPL-3</Copyright>
    <UseWindowsForms>true</UseWindowsForms>
    <!--
      This is the ONLY place warnings are suppressed for this project. The per-configuration
      PropertyGroups below must not reassign NoWarn, because that silently discards this value.

      CA1416 is deliberately NOT suppressed. It used to produce 10,128 warnings because
      GenerateAssemblyInfo=false stripped the generated [assembly: SupportedOSPlatform] attribute;
      with that fixed the count is 0, so the rule is now free to catch real platform problems.
      WFO1000 is also handled in .editorconfig; kept here so command-line builds agree with the IDE.
    -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <ProduceReferenceAssembly>False</ProduceReferenceAssembly>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DefineDebug>true</DefineDebug>
    <DefineTrace>true</DefineTrace>
    <DocumentationFile>
    </DocumentationFile>
    <!-- NoWarn intentionally not set here; it is inherited from the main PropertyGroup above.
         The list previously here was VB compiler codes (42016, 41999, ...) which are inert in a
         C# project, and assigning it discarded the real suppressions. -->

    <DefineConstants>
    </DefineConstants>
    <CodeAnalysisRuleSet>AllRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>None</DebugType>
    <DefineDebug>false</DefineDebug>
    <DefineTrace>false</DefineTrace>
    <DocumentationFile>
    </DocumentationFile>
    <!-- NoWarn intentionally not set here; it is inherited from the main PropertyGroup above.
         The list previously here was VB compiler codes (42016, 41999, ...) which are inert in a
         C# project, and assigning it discarded the real suppressions. -->

    <CodeAnalysisRuleSet>AllRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
